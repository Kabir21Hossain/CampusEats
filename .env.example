# CampusEats Environment Variables Template (Placeholders only)
# Copy this file to .env.local or .env for local development:
#   PowerShell: if (-not (Test-Path .env.local)) { Copy-Item .env.example .env.local }
#   Bash: test -f .env.local || cp .env.example .env.local

NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=campuseats
# For Atlas, set MONGODB_URI to the connection string from your MongoDB project.
# Transaction-based order and finance flows require a replica set or sharded cluster.

# Better Auth Configuration (Auth-authoritative session storage)
# Generate a secret: openssl rand -base64 32
# Set the same BETTER_AUTH_SECRET in the sibling backend environment file.
BETTER_AUTH_SECRET=your-32-character-random-secret-here
BETTER_AUTH_URL=http://localhost:3000
# Public Frontend Variables
# In production, use the deployed backend origin and keep the /api suffix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_CURRENCY=BDT
