# CampusEats Environment Variables Template (Placeholders only)
# Copy this file to .env.local or .env for local development:
#   PowerShell: if (-not (Test-Path .env.local)) { Copy-Item .env.example .env.local }
#   Bash: test -f .env.local || cp .env.example .env.local

NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=campuseats

# Better Auth Configuration (Auth-authoritative session storage)
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-random-secret-here
BETTER_AUTH_URL=http://localhost:3000
ADMIN_INVITATION_CODE=replace-with-a-secret-university-issued-code

# Public Frontend Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=BDT

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password-or-app-password>
EMAIL_FROM="CampusEats <no-reply@campuseats.edu.bd>"
